# Environment Configuration for Tuma Ride MVP

# Node / Backend
NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL Database (Render Managed basic-256mb / 0.1c or Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tumaride?schema=public

# Authentication & Security
JWT_SECRET=tumaride-change-this-secret-in-production
JWT_EXPIRES_IN=7d
WALLET_CHALLENGE_TIMEOUT_SECONDS=300

# Stellar Network & Soroban RPC
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
TUMARIDE_ESCROW_CONTRACT_ID=CB7KRT357CZNYU3XEPAX26SHM37QGJW75Z3RVUGRSKMFUOZSKLZQ7PJ4
USDC_TOKEN_CONTRACT_ID=CBIMG76HIG2UJDRT65WZ6KQITSGQQ4G5ANA4LAEOQUYYES3TTVKOKQF6

# Background Indexer
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000


